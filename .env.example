# Copy this file to .env and fill in real values. Never commit .env.

# --- FlightAware AeroAPI ---
# https://www.flightaware.com/commercial/aeroapi/ — Personal tier key.
AEROAPI_KEY=your-aeroapi-key-here
AEROAPI_BASE_URL=https://aeroapi.flightaware.com/aeroapi

# --- OpenSky Network (free, registered account recommended) ---
# OAuth2 client-credentials app: https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=your-opensky-client-id
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# --- Database ---
DATABASE_URL=postgresql+psycopg://flightcompanion:flightcompanion@localhost:5432/flightcompanion
# Used only by docker-compose to provision the local Postgres container:
POSTGRES_USER=flightcompanion
POSTGRES_PASSWORD=flightcompanion
POSTGRES_DB=flightcompanion

# --- App / cache tuning ---
ENV=dev
# How long a cached AeroAPI status snapshot stays fresh before a re-fetch is allowed.
AEROAPI_STATUS_CACHE_TTL_SECONDS=600
# How long cached past-flight history rows stay fresh.
AEROAPI_HISTORY_CACHE_TTL_SECONDS=604800
# Minimum seconds between backend->OpenSky calls for the same flight.
OPENSKY_MIN_POLL_INTERVAL_SECONDS=8
# Dev-safety net: max AeroAPI calls per day before the app starts refusing new calls (0 = unlimited).
AEROAPI_DAILY_CALL_BUDGET=200

# --- CORS (frontend dev server origin) ---
CORS_ALLOW_ORIGINS=http://localhost:5173
